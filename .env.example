# ─── Database ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=trainbooking
POSTGRES_USER=trainuser
POSTGRES_PASSWORD=change_me_in_production

# ─── Backend ────────────────────────────────────────────────────────────────────
# 32+ character random string — generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret_string_minimum_32_chars
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_DAYS=7

# AES-256 key for encrypting MFA secrets in DB (32 bytes hex)
MFA_ENCRYPTION_KEY=change_this_to_a_64_char_hex_string_for_aes256_encryption

# Fare config (LKR per km base rate for Third Reserved class)
FARE_BASE_RATE_PER_KM=2.50
FARE_PEAK_MULTIPLIER=1.2

# Rate limits (requests per minute)
RATE_LIMIT_GENERAL=100
RATE_LIMIT_BOOKING=20
RATE_LIMIT_AUTH=10

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# App environment: development | production
APP_ENV=development
APP_PORT=9090

# ─── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:9090
VITE_APP_NAME=SL Train Booking

# ─── Flyway (migrations) ────────────────────────────────────────────────────────
FLYWAY_URL=jdbc:postgresql://db:5432/trainbooking
FLYWAY_USER=trainuser
FLYWAY_PASSWORD=change_me_in_production
